{
  "name": "ams-access",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "prettier": "^3.8.3",
    "tsc-files": "^1.1.4",
    "turbo": "^2.9.9"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "tsc-files --noEmit"
    ],
    "**/*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write"
    ],
    "**/*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.6.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.30.3"
}
