{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMS Access",
  "version": "1.0.4",
  "identifier": "com.ams.access",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @ams/desktop prepare:helper && pnpm --filter @ams/web dev",
    "beforeBuildCommand": "pnpm --filter @ams/desktop prepare:helper && pnpm --filter @ams/web build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AMS Access",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "alwaysOnTop": false,
        "center": true,
        "userAgent": "AMS Access"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; font-src 'self' data:; connect-src 'self' https://*.run.app; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'self'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; font-src 'self' data:; connect-src 'self' http://localhost:* ws://localhost:* https://*.run.app; worker-src 'self' blob:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "dmg", "msi", "nsis"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.acs.microsoft.com",
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"],
        "postInstallScript": "debian/postinst",
        "preRemoveScript": "debian/prerm"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": null,
      "providerShortName": null
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../web/public/models/blazeface/*": "models/blazeface/",
      "helpers/com.ams.access.networkhelper": "helpers/com.ams.access.networkhelper",
      "helpers/com.ams.access.networkhelper.plist": "helpers/com.ams.access.networkhelper.plist",
      "helpers/ams-access-networkhelper": "helpers/ams-access-networkhelper",
      "helpers/ams-proctor-helper.service": "helpers/ams-proctor-helper.service",
      "helpers/com.ams.access.networkhelper.policy": "helpers/com.ams.access.networkhelper.policy"
    }
  }
}
