{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMS Access",
  "version": "0.1.0",
  "identifier": "com.ams.access",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @ams/web dev",
    "beforeBuildCommand": "pnpm --filter @ams/web build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AMS Access",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "alwaysOnTop": false,
        "center": true,
        "userAgent": "AMS Access"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "dmg"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist",
      "signingIdentity": null,
      "providerShortName": null
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../web/public/models/blazeface/*": "models/blazeface/"
    }
  }
}
