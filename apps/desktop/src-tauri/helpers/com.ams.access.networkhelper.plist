<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Must match the Rust binary name and the socket's label. -->
    <key>Label</key>
    <string>com.ams.access.networkhelper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/com.ams.access.networkhelper</string>
    </array>

    <!--
        Started on demand: launchd owns the socket and launches the helper on
        the first connection; the helper exits once idle. pf keeps its rules
        without it, so nothing runs between exams.
        SockPathMode 438 = 0666: the helper tightens it to root:staff 0660
        once running, and every peer is checked against the pinned app path.
    -->
    <key>Sockets</key>
    <dict>
        <key>Listeners</key>
        <dict>
            <key>SockPathName</key>
            <string>/private/var/run/ams-proctor.sock</string>
            <key>SockPathMode</key>
            <integer>438</integer>
        </dict>
    </dict>

    <!-- Helper must run as root so it can call pfctl. -->
    <key>UserName</key>
    <string>root</string>

    <!-- Route daemon output to a fixed log — inspect with: tail -f /var/log/ams-access-helper.log -->
    <key>StandardOutPath</key>
    <string>/var/log/ams-access-helper.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/ams-access-helper.log</string>

    <!-- The socket above lives in /private/var/run. -->
    <key>WorkingDirectory</key>
    <string>/private/var/run</string>
</dict>
</plist>
