[Unit]
# AMS Access privileged network helper (Linux equivalent of the macOS
# LaunchDaemon). Runs as root so it can drive iptables/ip6tables on behalf of
# the unprivileged, user-session exam app, which talks to it over the Unix
# socket /run/ams-proctor.sock. Installed by install_network_helper via pkexec.
Description=AMS Access privileged network lockdown helper
Documentation=https://ams.dev/access
After=network.target nss-lookup.target

[Service]
Type=simple
# Ensure the conntrack match module is present before the helper builds any
# firewall chain. The helper drops CAP_SYS_MODULE (see CapabilityBoundingSet),
# so it cannot lazily autoload a kernel match itself; load it here in the
# service-manager context where module loading is permitted. Non-fatal ("-"):
# if conntrack is built-in or already loaded, modprobe is a harmless no-op.
ExecStartPre=-/usr/sbin/modprobe nf_conntrack
# The helper binary is installed here by install_network_helper.
ExecStart=/usr/local/lib/ams-access/ams-access-networkhelper
User=root
# Restart if it dies mid-exam; the app re-pings the socket before relying on it.
Restart=on-failure
RestartSec=1
# Hardening: the helper only needs to run iptables/ip6tables and bind one
# socket. It does NOT need to write the rest of the filesystem.
NoNewPrivileges=false
ProtectHome=true
ProtectSystem=full
# Capability bounding set — every entry here is REQUIRED; do not trim:
#   CAP_NET_ADMIN / CAP_NET_RAW  iptables/ip6tables firewall management.
#   CAP_CHOWN / CAP_DAC_OVERRIDE chown + 0666 the /run socket node.
#   CAP_SYS_PTRACE               REQUIRED to authenticate the client. The helper
#       authorizes a connecting peer by resolving readlink(/proc/<pid>/exe) and
#       matching it against the pinned client path. The peer is an UNPRIVILEGED
#       (different-uid) process, so the kernel gates that readlink behind
#       ptrace_may_access(PTRACE_MODE_READ_FSCREDS), which a root process can
#       only pass with CAP_SYS_PTRACE — CAP_DAC_OVERRIDE does NOT cover it.
#       Without this cap authorize_client fails with EACCES for every client,
#       so every command (including the readiness `ping`) is refused and the
#       network-lockdown readiness check is permanently FAIL → entry BLOCKED.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN CAP_DAC_OVERRIDE CAP_SYS_PTRACE

[Install]
WantedBy=multi-user.target
