<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for WebKit/WKWebView JIT compilation under hardened runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Required to load WebKit's unsigned dylibs under hardened runtime -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Required for CGEventTap (keyboard intercept) — user must also grant
       Accessibility permission in System Preferences → Privacy & Security -->
  <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
  <array>
    <string>com.apple.accessibility.AXBackBoardServer</string>
  </array>
</dict>
</plist>
