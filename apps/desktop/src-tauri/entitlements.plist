<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for WebKit/WKWebView JIT compilation under hardened runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Required to load WebKit's unsigned dylibs under hardened runtime -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Required for CGEventTap (keyboard intercept) — user must also grant
       Accessibility permission in System Preferences → Privacy & Security -->
  <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
  <array>
    <string>com.apple.accessibility.AXBackBoardServer</string>
  </array>
  <!-- Scopes the main app's authority to manage exactly one daemon label.
       Currently the helper is bootstrapped via launchctl inside an osascript
       shell (no entitlement required). This entry is pre-staged for the
       SMAppService.daemon() migration on macOS 13+, which does require it. -->
  <key>com.apple.developer.service-management.launch-control</key>
  <array>
    <string>com.ams.access.networkhelper</string>
  </array>
</dict>
</plist>
