{
  "name": "@ams/web",
  "version": "1.0.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/setup-tfjs-wasm.mjs && node scripts/setup-blazeface-model.mjs",
    "prebuild": "node scripts/setup-tfjs-wasm.mjs && node scripts/setup-blazeface-model.mjs && node scripts/setup-mediapipe.mjs --if-used",
    "build": "next build && node scripts/check-size-budgets.mjs",
    "lint": "next typegen && tsc --noEmit",
    "test": "node --test --experimental-strip-types src/app/session/contest/submission-state.test.mjs src/app/session/contest/countdown.test.mjs src/lib/verdict.test.mjs src/lib/candidate-auth.test.mjs src/lib/theme-core.test.mjs src/lib/theme-dark-lock-core.test.mjs src/lib/theme-dark-lock-coverage.test.mjs src/lib/home-tokenize-aa.test.mjs src/lib/home-color-completeness.test.mjs src/app/session/contest/autosave-timing.test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "clean": "rm -rf .next out",
    "mediapipe:setup": "node scripts/setup-mediapipe.mjs",
    "size:check": "node scripts/check-size-budgets.mjs"
  },
  "dependencies": {
    "@ams/api-client": "workspace:*",
    "@ams/shared-ui": "workspace:*",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@lezer/highlight": "^1.2.1",
    "@mediapipe/tasks-vision": "^0.10.35",
    "dompurify": "^3.2.6",
    "@tensorflow-models/blazeface": "^0.1.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "framer-motion": "^11.0.0",
    "katex": "^0.16.11",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.4",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
